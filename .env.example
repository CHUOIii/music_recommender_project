# Hugging Face Access Token để stream dataset GD-Studio/embeat_45m_spotify_tracks
# Lấy token tại: https://huggingface.co/settings/tokens
# Lưu ý: Cần bấm "Accept License" tại https://huggingface.co/datasets/GD-Studio/embeat_45m_spotify_tracks
HF_TOKEN=hf_your_access_token_here

# Chế độ nạp dữ liệu (full | compact | sample)
DATA_SCALE_MODE=sample
SAMPLE_RATIO=0.5

